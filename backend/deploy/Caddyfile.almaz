{
	# Almaz / Cloudflare edge terminates public DNS; Caddy proxies to the NUC API.
	# Set a real contact email before going live.
	email ops@example.com
}

museum-api.example.com {
	encode zstd gzip
	# Replace nuc.lan or 192.168.x.x with the NUC hostname/IP reachable from Almaz.
	reverse_proxy http://nuc.lan:8080
}
